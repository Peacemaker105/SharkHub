<?xml version="1.0" encoding="utf-8"?>
<!-- Layers generated from design/icon by tools/make_icons.py; the launcher applies its own mask.
     The themed-icon (monochrome) variant lives in mipmap-anydpi-v33: <monochrome> is API 33, and
     putting it here would push the whole icon to v33, leaving Android 12 without one. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
