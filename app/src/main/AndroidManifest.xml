<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sensors: accelerometer/rotation for the inclinometer -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <!-- OTA self-update + in-app sideloader: fetch manifest/apk, run upload server, install -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12: lets OTA (and updates to apps we installed) skip the confirm dialog -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Package visibility: targetSdk 30+ hides other apps, so without this the deep-link tiles can't
         resolve the BYD apps and the probe reports every one as missing. Sideloaded, so Play's
         restrictions on this permission don't apply. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Reading local .apk files for the "Local APK files" list (legacy storage on the head unit) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Bluetooth helper. NEW perms are for API31+; legacy ones for the DiLink-3 (API29) fallback -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- API 29/30 only return discovery results with fine location (the screen already asks for it) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- BYD vehicle API (android.hardware.bydauto devices). Defined by the car's firmware as
         android.permission.BYDAUTO_<DEVICE>_{GET,SET,COMMON}; on the Shark 6 (SOC_260811_S) nearly all
         are "normal", i.e. granted at install. Those marked dangerous need a runtime grant.
         Reading everything we display; SET only where Shark Hub changes something. -->
    <uses-permission android:name="android.permission.BYDAUTO_AC_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_AC_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_AC_SET" />
    <uses-permission android:name="android.permission.BYDAUTO_STATISTIC_COMMON" /> <!-- dangerous -->
    <uses-permission android:name="android.permission.BYDAUTO_STATISTIC_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_BODYWORK_COMMON" /> <!-- dangerous -->
    <uses-permission android:name="android.permission.BYDAUTO_BODYWORK_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_SPEED_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_SPEED_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_INSTRUMENT_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_INSTRUMENT_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_CHARGING_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_CHARGING_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_CHARGING_SET" /> <!-- SOC save switch -->

    <uses-permission android:name="android.permission.BYDAUTO_SENSOR_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_SENSOR_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_TYRE_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_TYRE_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_SETTING_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_SETTING_GET" />
    <!-- Seat heating/ventilation live on the setting device on the Shark 6 -->
    <uses-permission android:name="android.permission.BYDAUTO_SETTING_SET" />
    <!-- ADAS (cruise/ACC, auto high-beam, safety alerts), lights, parking radar (sentry proximity)
         and the panorama/360 device. Opening each device requires its COMMON permission; all four
         families are "normal" on the Shark 6 (probe 2026-09-28). See docs/VEHICLE_CONTROLS.md. -->
    <uses-permission android:name="android.permission.BYDAUTO_ADAS_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_ADAS_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_ADAS_SET" />
    <uses-permission android:name="android.permission.BYDAUTO_LIGHT_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_LIGHT_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_LIGHT_SET" />
    <uses-permission android:name="android.permission.BYDAUTO_RADAR_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_RADAR_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_PANORAMA_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_PANORAMA_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_PM2P5_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_PM2P5_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_POWER_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_POWER_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_GEARBOX_COMMON" /> <!-- dangerous -->
    <uses-permission android:name="android.permission.BYDAUTO_GEARBOX_GET" />
    <!-- engine rpm / power for the gauges screen; the motor device lists no permission of its own -->
    <uses-permission android:name="android.permission.BYDAUTO_ENGINE_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_ENGINE_GET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SharkHub"
        android:largeHeap="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.SharkHub">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- adb-only probe trigger (see ProbeReceiver). DUMP is held by the adb shell, not by apps. -->
        <receiver
            android:name=".car.ProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Receives PackageInstaller callbacks (shows the confirm dialog, reports success) -->
        <receiver
            android:name=".sideload.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.chris.sharkhub.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <!-- FileProvider so the OTA installer can hand the downloaded APK to the package installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
