<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shark Hub Installer" Width="580" Height="1000" MinWidth="500" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#040A16"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="#EAF3FF"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <!-- Shark Hub's Deep Sea theme: navy ground, surface cards, one accent. Loaded at runtime by
       SharkHubInstaller.cs (XamlReader), so there is no code-behind here: events are wired by name. -->
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#EAF3FF"/>
    <SolidColorBrush x:Key="Dim" Color="#8DA1BF"/>
    <SolidColorBrush x:Key="Accent" Color="#2EB8FF"/>
    <SolidColorBrush x:Key="OnAccent" Color="#00121F"/>
    <SolidColorBrush x:Key="Surface" Color="#0A1426"/>
    <SolidColorBrush x:Key="Variant" Color="#111E36"/>
    <SolidColorBrush x:Key="Hairline" Color="#1C2B45"/>
    <FontFamily x:Key="Glyphs">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="18,14,18,16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="StepBadge" TargetType="Border">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="CornerRadius" Value="13"/>
      <Setter Property="Background" Value="#15304F"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style x:Key="StepNumber" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="StepText" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="#C9D6EA"/>
      <Setter Property="LineHeight" Value="19"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Height" Value="50"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="15">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#5CCBFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#1C9CDB"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.32"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{StaticResource Variant}" BorderBrush="#243653" BorderThickness="1" CornerRadius="13">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="#2EB8FF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#0D1830"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChipButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="#12304F" BorderBrush="#2EB8FF" BorderThickness="1" CornerRadius="18" Padding="16,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#1A4570"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter x:Name="C"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#EAF3FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Frame" Background="#07101F" BorderBrush="#243653" BorderThickness="1.5" CornerRadius="13" Padding="14,0">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#2EB8FF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Border Background="#26385A" CornerRadius="4" Margin="1,2"/></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <!-- a soft accent glow in the corner, like the app's ambient light -->
    <Rectangle IsHitTestVisible="False">
      <Rectangle.Fill>
        <RadialGradientBrush Center="0.92,0.02" GradientOrigin="0.92,0.02" RadiusX="0.75" RadiusY="0.45">
          <GradientStop Color="#262EB8FF" Offset="0"/>
          <GradientStop Color="#002EB8FF" Offset="1"/>
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,16,24,16">

        <!-- header -->
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Image x:Name="Logo" Width="54" Height="46" Margin="0,0,14,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Shark Hub" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="26" FontWeight="SemiBold"/>
              <TextBlock Text="By Muzz" Foreground="{StaticResource Dim}" FontSize="13" Margin="10,0,0,4" VerticalAlignment="Bottom"/>
            </StackPanel>
            <TextBlock Text="Installer for the BYD Shark 6 head unit" Foreground="{StaticResource Dim}" FontSize="13.5" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>

        <!-- 1. ADB mode -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <TextBlock Text="&#xE804;" FontFamily="{StaticResource Glyphs}" FontSize="18" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock Text="Put the car in ADB mode" Style="{StaticResource CardTitle}"/>
            </StackPanel>

            <DockPanel Margin="0,0,0,8">
              <Border Style="{StaticResource StepBadge}"><TextBlock Text="1" Style="{StaticResource StepNumber}"/></Border>
              <TextBlock Style="{StaticResource StepText}">With the truck switched on, <Run FontWeight="SemiBold" Foreground="#EAF3FF">rotate the screen to portrait</Run>. The hidden menu only shows in portrait.</TextBlock>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
              <Border Style="{StaticResource StepBadge}"><TextBlock Text="2" Style="{StaticResource StepNumber}"/></Border>
              <StackPanel>
                <TextBlock Style="{StaticResource StepText}">Open <Run FontWeight="SemiBold" Foreground="#EAF3FF">Settings → System</Run> and tap the <Run FontWeight="SemiBold" Foreground="#EAF3FF">Factory Reset</Run> text about 10 times, until a developer screen opens.</TextBlock>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0">Tap the words themselves. If a reset question ever pops up, press Cancel.</TextBlock>
              </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
              <Border Style="{StaticResource StepBadge}"><TextBlock Text="3" Style="{StaticResource StepNumber}"/></Border>
              <TextBlock Style="{StaticResource StepText}">On that screen, tap the <Run FontWeight="SemiBold" Foreground="#EAF3FF">top button</Run> to switch ADB on.</TextBlock>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
              <Border Style="{StaticResource StepBadge}"><TextBlock Text="4" Style="{StaticResource StepNumber}"/></Border>
              <StackPanel>
                <TextBlock Style="{StaticResource StepText}">Join the car and this PC to the <Run FontWeight="SemiBold" Foreground="#EAF3FF">same Wi-Fi</Run>. A phone hotspot is easiest.</TextBlock>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0">You'll need the car's IP address: Settings → Wi-Fi → your network. Or press Find the car below.</TextBlock>
              </StackPanel>
            </DockPanel>
            <DockPanel>
              <Border Style="{StaticResource StepBadge}"><TextBlock Text="5" Style="{StaticResource StepNumber}"/></Border>
              <TextBlock Style="{StaticResource StepText}">When you press Install, the car asks <Run FontWeight="SemiBold" Foreground="#EAF3FF">Allow USB debugging?</Run> Tick Always allow and tap OK.</TextBlock>
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- 2. The app -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource Glyphs}" FontSize="18" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock Text="Choose the app" Style="{StaticResource CardTitle}"/>
            </StackPanel>
            <UniformGrid Columns="2">
              <Button x:Name="GitHubButton" Style="{StaticResource GhostButton}" Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE896;" FontFamily="{StaticResource Glyphs}" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock Text="Latest Shark Hub" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="FileButton" Style="{StaticResource GhostButton}" Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE838;" FontFamily="{StaticResource Glyphs}" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock Text="Choose APK file…" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </UniformGrid>
            <Border x:Name="ApkPanel" Background="#07101F" CornerRadius="12" Padding="14,8" Margin="0,10,0,0">
              <DockPanel>
                <TextBlock x:Name="ApkGlyph" Text="&#xE7B8;" FontFamily="{StaticResource Glyphs}" FontSize="20" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="ApkName" Text="No app chosen yet" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="ApkInfo" Text="Download the latest release, or pick an APK on this PC." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- 3. IP -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <TextBlock Text="&#xE701;" FontFamily="{StaticResource Glyphs}" FontSize="18" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock Text="The car's IP address" Style="{StaticResource CardTitle}"/>
            </StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid>
                <TextBox x:Name="IpBox" Style="{StaticResource Field}"/>
                <TextBlock x:Name="IpPlaceholder" Text="e.g. 192.168.43.120" IsHitTestVisible="False" Foreground="#4A5F80"
                           FontSize="19" FontFamily="Segoe UI Variable Display, Segoe UI" VerticalAlignment="Center" Margin="17,0,0,0"/>
              </Grid>
              <Button x:Name="ScanButton" Grid.Column="1" Style="{StaticResource GhostButton}" Height="48" Width="154" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE721;" FontFamily="{StaticResource Glyphs}" FontSize="15" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock Text="Find the car" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Grid>
            <WrapPanel x:Name="FoundPanel" Margin="0,10,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="IpHint" Style="{StaticResource Hint}" Margin="2,6,0,0" Text="Port 5555 is used unless you add one, like 10.0.0.5:5555."/>
          </StackPanel>
        </Border>

        <!-- install -->
        <Button x:Name="InstallButton" Style="{StaticResource AccentButton}" Margin="0,4,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE898;" FontFamily="{StaticResource Glyphs}" FontSize="17" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="InstallLabel" Text="Install on the car" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <!-- status -->
        <Border x:Name="StatusPanel" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                CornerRadius="14" Padding="16,12" Margin="0,12,0,0" Visibility="Collapsed">
          <StackPanel>
            <DockPanel>
              <TextBlock x:Name="StatusGlyph" Text="&#xE895;" FontFamily="{StaticResource Glyphs}" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button x:Name="DetailsButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Details" VerticalAlignment="Center" Margin="10,0,0,0"/>
              <TextBlock x:Name="StatusText" Text="" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid x:Name="ProgressTrack" Height="6" Margin="0,10,0,0" ClipToBounds="True" Visibility="Collapsed">
              <Border Background="#16263F" CornerRadius="3"/>
              <Border x:Name="ProgressFill" Background="{StaticResource Accent}" CornerRadius="3" HorizontalAlignment="Left" Width="0">
                <Border.RenderTransform><TranslateTransform x:Name="ProgressShift"/></Border.RenderTransform>
              </Border>
            </Grid>
            <TextBox x:Name="LogBox" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" Height="140" Margin="0,12,0,0"
                     Background="#050C19" Foreground="#8DA1BF" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                     VerticalScrollBarVisibility="Auto" Padding="8"/>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,14,0,0" FontSize="11.5"
                   Text="Installs over Wi-Fi with Google's adb, downloaded on first use if this PC doesn't have it."/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
